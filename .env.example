# Kaufee-Home Configuration

# Designated workspace path (defaults to ./workspace if not set)
KAUFEE_WORKSPACE=./workspace

# LLM Provider: 'ollama', 'remote', 'hybrid', or 'mock'
KAUFEE_LLM_PROVIDER=ollama

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
KAUFEE_OLLAMA_KEEP_ALIVE=10m
KAUFEE_OLLAMA_NUM_PREDICT=2048

# Remote Provider Configuration (OpenAI, Gemini OpenAI-compatible, Groq, etc.)
REMOTE_API_BASE_URL=https://api.openai.com/v1
REMOTE_API_KEY=
REMOTE_MODEL=gpt-4o-mini

# Execution Runner: 'auto', 'subprocess', or 'docker' (network none, 512MB RAM)
KAUFEE_RUNNER_TYPE=auto

# Autonomy & Approval Modes
KAUFEE_AUTONOMY_MODE=assisted       # 'manual', 'assisted', or 'autonomous'
KAUFEE_APPROVAL_MODE=plan           # 'plan' (approve full plan upfront) or 'step' (prompt on each action)

# Execution & Safety Limits
KAUFEE_MAX_STEPS=12
KAUFEE_MAX_REPAIRS=3
KAUFEE_STEP_TIMEOUT=15
KAUFEE_MAX_OUTPUT_BYTES=50000
KAUFEE_REQUIRE_APPROVAL_FOR_DELETE=true
KAUFEE_REQUIRE_APPROVAL_FOR_PYTHON=true
KAUFEE_REQUIRE_APPROVAL_FOR_INSTALL=true
KAUFEE_ALLOW_ARBITRARY_SHELL=false

# Responsible AI Guardrails & Circuit Breaker
KAUFEE_PROMPT_INJECTION_GUARD=true
KAUFEE_SENSITIVE_REDACTION=true
KAUFEE_CIRCUIT_BREAKER_THRESHOLD=3

# Persistence & Audit
KAUFEE_AUDIT_LOG_DIR=./.kaufee/audit
